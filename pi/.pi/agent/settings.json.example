{
  "theme": "omarchy-system",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openai-codex/*",
    "xai/*"
  ],
  "packages": [
    {
      "source": "npm:@dietrichgebert/ponytail@4.10.0",
      "extensions": [],
      "skills": [
        "skills/ponytail-review/SKILL.md",
        "skills/ponytail-audit/SKILL.md",
        "skills/ponytail-debt/SKILL.md"
      ]
    },
    "npm:pi-subagents@0.70.0",
    "npm:@ff-labs/pi-fff@0.10.6",
    "npm:pi-context-view@0.5.2",
    "npm:pi-web-access@0.30.0",
    "npm:@narumitw/pi-plan-mode@0.58.2"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "xhigh",
        "defaultContext": "fresh"
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low",
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "ffgrep",
          "fffind"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "ffgrep",
          "fffind"
        ]
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "xhigh",
        "defaultContext": "fresh"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "xhigh"
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      }
    }
  },
  "tuiMode": "fullscreen"
}
