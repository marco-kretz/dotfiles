{
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "packages": [
    {
      "source": "npm:@dietrichgebert/ponytail@4.9.0",
      "extensions": [],
      "skills": [
        "skills/ponytail-review/SKILL.md",
        "skills/ponytail-audit/SKILL.md",
        "skills/ponytail-debt/SKILL.md"
      ]
    },
    "npm:pi-subagents@0.67.0",
    "npm:@ff-labs/pi-fff@0.10.6",
    "npm:pi-context-view@0.5.2",
    "npm:pi-web-access@0.28.0",
    "npm:@narumitw/pi-plan-mode@0.57.1"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "medium",
        "defaultContext": "fresh",
        "inheritGlobalContext": true
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low",
        "defaultContext": "fresh",
        "inheritGlobalContext": true,
        "tools": [
          "read",
          "grep",
          "find",
          "ls"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "medium",
        "defaultContext": "fresh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls"
        ],
        "inheritGlobalContext": true
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "high",
        "defaultContext": "fresh",
        "inheritGlobalContext": true
      }
    }
  },
  "tuiMode": "fullscreen"
}
