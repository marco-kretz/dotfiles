#!/bin/bash
# systemd-sleep hook: turn OpenRGB off before suspend, restore the Noctalia accent after resume.
exec 2>&1
log() { logger -t openrgb-sleep "$*"; }

log "invoked: action=$1 phase=$2"

case "$1" in
  pre)
    HOME=/root /usr/bin/openrgb -m direct -c 000000 >/dev/null 2>&1
    log "pre: openrgb blank exit=$?"
    ;;
  post)
    runuser -u marco -- env HOME=/home/marco /home/marco/.config/noctalia/palette-sync >/dev/null 2>&1
    log "post: palette-sync exit=$?"
    ;;
esac
