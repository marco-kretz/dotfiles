[Unit]
Description=Apply OpenRGB profile
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c '%h/.config/omarchy/hooks/theme-set.d/openrgb-accent.sh "$(cat %h/.local/state/omarchy/current/theme.name)"'
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
