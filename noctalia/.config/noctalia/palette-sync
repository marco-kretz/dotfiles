#!/usr/bin/env python3
"""Noctalia colors_changed hook: push the active custom palette to Firefox
(Pywalfox), Vesktop, Brave and OpenRGB.

Run with --check for a self-test."""

import json
import os
import shutil
import subprocess
import sys
import tempfile
import tomllib

HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".config/noctalia")
# Noctalia 5 persists GUI/IPC choices like the color scheme here, not in ~/.config.
SETTINGS = os.path.join(HOME, ".local/state/noctalia/settings.toml")
NAMES = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]


def active_palette(settings, config_dir):
    # shortcut: custom palettes only; wallpaper-generated colors have no file to read.
    if not os.path.exists(settings):
        return None
    theme = tomllib.load(open(settings, "rb")).get("theme", {})
    if theme.get("source") != "custom" or not theme.get("custom_palette"):
        return None
    palette = json.load(open(os.path.join(config_dir, "palettes", theme["custom_palette"] + ".json")))
    return palette["dark"] if theme.get("mode") != "light" else palette.get("light", palette["dark"])


def pywal(p):
    t = p["terminal"]
    colors = [t["normal"][n] for n in NAMES] + [t["bright"][n] for n in NAMES]
    # pywal convention: color0 is the background, color15 the foreground.
    colors[0], colors[15] = t["background"], t["foreground"]
    return {
        "wallpaper": "",
        "special": {"background": colors[0], "foreground": colors[15], "cursor": t["cursor"]},
        "colors": {f"color{i}": v for i, v in enumerate(colors)},
    }


def vesktop(p):
    rows = {
        "background-base-lowest": p["mShadow"],
        "background-base-lower": p["mShadow"],
        "background-base-low": p["mSurface"],
        "background-surface-high": p["mSurfaceVariant"],
        "background-surface-higher": p["mSurfaceVariant"],
        "background-surface-highest": p["mOutline"],
        "chat-background-default": p["mSurface"],
        "text-default": p["mOnSurface"],
        "text-strong": p["mOnHover"],
        "text-muted": p["mOnSurfaceVariant"],
        "text-link": p["terminal"]["normal"]["blue"],
        "interactive-normal": p["mOnSurface"],
        "interactive-hover": p["mOnHover"],
        "interactive-active": p["mOnHover"],
        "interactive-muted": p["mOnSurfaceVariant"],
        "brand-500": p["mPrimary"],
    }
    body = "\n".join(f"  --{k}: {v} !important;" for k, v in rows.items())
    return ("/**\n * @name Noctalia\n * @description Generated from the Noctalia palette by"
            " ~/.config/noctalia/palette-sync\n */\n"
            f":root, .theme-dark, .theme-darker, .theme-midnight, .theme-light {{\n{body}\n}}\n")


def brave(p):
    # Unpacked Chromium theme: the BrowserThemeColor policy only seeds a lighter Material palette.
    rgb = lambda h: [int(h.lstrip("#")[i:i + 2], 16) for i in (0, 2, 4)]
    bg, fg, light, dark = rgb(p["mSurface"]), rgb(p["mOnSurface"]), rgb(p["mSurfaceVariant"]), rgb(p["mShadow"])
    return {
        "manifest_version": 3,
        "name": "Noctalia",
        "version": "1.0",
        "theme": {"colors": {
            "frame": bg, "frame_inactive": bg,
            "toolbar": bg, "toolbar_text": fg, "toolbar_button_icon": fg,
            "background_tab": light, "background_tab_inactive": light,
            "tab_text": fg, "tab_background_text": fg, "tab_background_text_inactive": fg,
            "bookmark_text": fg,
            "omnibox_background": light, "omnibox_text": fg,
            "ntp_background": dark, "ntp_text": fg,
        }},
    }


def openrgb_accent(p, config_dir):
    # A hand-picked hex in ~/.config/noctalia/openrgb-accent wins, for LEDs that need a clearer color than the UI accent.
    override = os.path.join(config_dir, "openrgb-accent")
    if os.path.exists(override):
        return open(override).read().strip().lstrip("#")[:6]
    return p["mPrimary"].lstrip("#")


def write(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(content if isinstance(content, str) else json.dumps(content, indent=2))


def main():
    p = active_palette(SETTINGS, CONFIG)
    if p is None:
        return
    if shutil.which("pywalfox"):
        write(os.path.join(HOME, ".cache/wal/colors.json"), pywal(p))
        subprocess.run(["pywalfox", "update"], capture_output=True)
    if os.path.isdir(os.path.join(HOME, ".config/vesktop/themes")):
        write(os.path.join(HOME, ".config/vesktop/themes/noctalia.theme.css"), vesktop(p))
    write(os.path.join(HOME, ".local/share/noctalia-brave-theme/manifest.json"), brave(p))
    if shutil.which("openrgb"):
        subprocess.run(["openrgb", "-m", "direct", "-c", openrgb_accent(p, CONFIG)], capture_output=True)


FIXTURE = {"dark": {
    "mPrimary": "#ff6b75", "mSurface": "#1c1b19", "mOnSurface": "#e8dcc8",
    "mSurfaceVariant": "#302c28", "mOnSurfaceVariant": "#a79c8c", "mOutline": "#3d3733",
    "mShadow": "#11100f", "mOnHover": "#fff2dd",
    "terminal": {
        "normal": {"black": "#1c1b19", "red": "#ff9585", "green": "#85d9c3", "yellow": "#efd08a",
                   "blue": "#91bff2", "magenta": "#ceb2ec", "cyan": "#a7dceb", "white": "#e8dcc8"},
        "bright": {"black": "#a79c8c", "red": "#ffb3a5", "green": "#a7efda", "yellow": "#ffe3a6",
                   "blue": "#b6d7ff", "magenta": "#e5ceff", "cyan": "#c6f0fa", "white": "#fff2dd"},
        "foreground": "#e8dcc8", "background": "#1c1b19", "cursor": "#fff2dd",
    },
}}


def check():
    with tempfile.TemporaryDirectory() as d:
        write(os.path.join(d, "palettes/Akari.json"), FIXTURE)
        settings = os.path.join(d, "settings.toml")
        assert active_palette(settings, d) is None
        write(settings, '[theme]\nsource = "community"\ncustom_palette = "Akari"\n')
        assert active_palette(settings, d) is None
        write(settings, '[theme]\nsource = "custom"\ncustom_palette = "Akari"\n')
        p = active_palette(settings, d)
        wal = pywal(p)["colors"]
        assert (wal["color0"], wal["color1"], wal["color15"]) == ("#1c1b19", "#ff9585", "#e8dcc8")
        assert "--brand-500: #ff6b75 !important;" in vesktop(p)
        assert brave(p)["theme"]["colors"]["frame"] == [0x1c, 0x1b, 0x19]
        assert openrgb_accent(p, d) == "ff6b75"
        write(os.path.join(d, "openrgb-accent"), "#ff2233\n")
        assert openrgb_accent(p, d) == "ff2233"
    print("PASS")


if __name__ == "__main__":
    check() if "--check" in sys.argv else main()
