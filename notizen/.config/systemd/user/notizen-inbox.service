[Unit]
Description=Notizen-Inbox einsortieren (Claude Code)
Documentation=file://%h/Dokumente/Notizen/CLAUDE.md
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/notizen-inbox
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/Dokumente/Notizen

# Ein hängender Lauf soll den Rechner nicht blockieren
TimeoutStartSec=15min

NoNewPrivileges=true
