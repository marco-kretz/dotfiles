#!/usr/bin/env bash
set -euo pipefail

VAULT="$HOME/Dokumente/Notizen"
INBOX="$VAULT/00 Inbox/Inbox.md"
STATE="$HOME/.local/state/notizen-inbox"
LOG="$STATE/inbox.log"
SNAPSHOTS="$STATE/snapshots"
WATERMARK="$STATE/eingang-watermark"

mkdir -p "$SNAPSHOTS"
chmod 700 "$STATE" "$SNAPSHOTS"

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"; }
touch "$LOG" && chmod 600 "$LOG"

MCP_TOOLS="mcp__claude_ai_Microsoft_365__chat_message_search"
MCP_TOOLS="$MCP_TOOLS mcp__claude_ai_Microsoft_365__teams_list_chats"
MCP_TOOLS="$MCP_TOOLS mcp__claude_ai_Microsoft_365__outlook_email_search"
MCP_TOOLS="$MCP_TOOLS mcp__claude_ai_Microsoft_365__read_resource"

# Alles nach dem letzten "---" gilt als erfasster Inhalt.
has_entries() {
    awk '/^---$/ { buf = ""; next } { buf = buf $0 "\n" } END { print buf }' "$INBOX" \
        | grep -qE '[^[:space:]]'
}

loose_files() {
    find "$VAULT/00 Inbox" -maxdepth 1 -name '*.md' ! -name 'Inbox.md' -print -quit | grep -q .
}

if [[ ! -f "$INBOX" ]]; then
    log "ABBRUCH: $INBOX nicht gefunden"
    exit 1
fi

cd "$VAULT"

# ------------------------------------------------------------------ Eingang
# Stichzeitpunkt VOR dem Abruf festhalten: Nachrichten, die währenddessen
# eintreffen, fielen sonst zwischen diesen und den nächsten Lauf.
NOW="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
SINCE="$(cat "$WATERMARK" 2>/dev/null || true)"
[[ -z "$SINCE" ]] && SINCE="$(date -u -d '24 hours ago' '+%Y-%m-%dT%H:%M:%SZ')"

log "Eingang abrufen seit $SINCE"
if claude -p "/eingang $SINCE" \
    --model sonnet \
    --permission-mode acceptEdits \
    --allowedTools Read Write Edit Glob Grep $MCP_TOOLS \
    >>"$LOG" 2>&1
then
    printf '%s' "$NOW" >"$WATERMARK" && chmod 600 "$WATERMARK"
    log "Eingang beendet, Wasserzeichen auf $NOW"
else
    # Wasserzeichen bleibt stehen, der Zeitraum wird beim nächsten Lauf
    # nachgeholt. Häufigste Ursache: abgelaufener Microsoft-365-Connector,
    # der sich nur interaktiv per /mcp neu verbinden lässt.
    log "FEHLER: Eingang fehlgeschlagen (Status $?) - Connector mit 'claude' + /mcp pruefen"
fi

# ------------------------------------------------------------------ Triage
if ! has_entries && ! loose_files; then
    log "Inbox leer - Triage übersprungen"
    exit 0
fi

# Snapshot vor dem Lauf, damit nichts unwiederbringlich verloren geht
SNAP="$SNAPSHOTS/Inbox-$(date '+%Y%m%d-%H%M%S').md"
cp "$INBOX" "$SNAP" && chmod 600 "$SNAP"
find "$SNAPSHOTS" -name 'Inbox-*.md' -mtime +30 -delete

log "Start Triage"

# Sonnet reicht für Triage; Effort bleibt auf medium, weil das Erkennen
# mehrdeutiger Einträge ("liegen lassen statt raten") Urteilsvermögen braucht.
if claude -p "/inbox" \
    --model sonnet \
    --permission-mode acceptEdits \
    --allowedTools Read Write Edit Glob Grep \
    >>"$LOG" 2>&1
then
    log "Triage beendet"
else
    log "FEHLER: claude beendete sich mit Status $?"
    exit 1
fi
